# MQTT Broker Configuration
# BROKER_MODE can be 'local' (HiveMQ CE in Docker) or 'cloud' (HiveMQ Cloud TLS)
BROKER_MODE=local

# Local HiveMQ CE
LOCAL_BROKER_HOST=localhost
LOCAL_BROKER_PORT=1883

# HiveMQ Cloud Configuration (TLS Enabled)
CLOUD_BROKER_HOST=your-cluster-id.s1.eu.hivemq.cloud
CLOUD_BROKER_PORT=8883
CLOUD_BROKER_USERNAME=factory_operator
CLOUD_BROKER_PASSWORD=YourSecureHiveMQPassword123!

# Storage & Database
DB_PATH=data/factory.db
DATA_RETENTION_DAYS=30

# Production Line Simulation Settings
SIMULATION_SPEEDUP=1.0
FAILURE_RATE=0.08
RANDOM_SEED=42

# ML Model Paths & Inference Settings
MODEL_PATH=models/latest_model.joblib
INFERENCE_INTERVAL_SECONDS=2
MIN_LEAD_TIME_WARNING_MIN=15

# Risk Thresholds
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.60
RISK_THRESHOLD_HIGH=0.85

# Alerting & Notifications
ALERT_COOLDOWN_MINUTES=5
ALERT_AUTO_ESCALATE_MINUTES=10
WEBHOOK_SLACK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
